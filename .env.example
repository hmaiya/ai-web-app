# Optional until a feature uses Supabase. These two values are public by design.
# The older anon key can also be used as the publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Optional until an AI integration is implemented.
# Never prefix a secret with NEXT_PUBLIC_.
OPENAI_API_KEY=
AI_MODEL=

# No service-role key is needed by this scaffold.
# Never use a Supabase secret/service-role key in a browser client.
